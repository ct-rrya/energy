# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Database
MONGODB_URI=

# JWT Authentication
JWT_SECRET=
JWT_EXPIRATION=7d

# Initial Admin Account (for seed script)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Messenger Bot (Facebook)
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_VERIFY_TOKEN=
MESSENGER_APP_SECRET=

# ESP32 Authentication
IOT_API_KEY=

# CORS
CORS_ORIGIN=http://localhost:5173

# Frontend URLs
# FRONTEND_URL: Used in access code emails for login link
# Development: http://localhost:5173
# Production: https://your-production-domain.com
FRONTEND_URL=http://localhost:5173
PRODUCTION_URL=

# Notifications
ENABLE_NOTIFICATIONS=true
NOTIFICATION_THRESHOLD_POWER=100

# Phase 7: Notification Platform Configuration
NOTIFICATION_TIMEZONE=Asia/Manila
NOTIFICATION_DAILY_SUMMARY_HOUR=20
NOTIFICATION_WEEKLY_SUMMARY_DAY=1
NOTIFICATION_WEEKLY_SUMMARY_HOUR=9
NOTIFICATION_RATE_LIMIT=50
NOTIFICATION_BATCH_DELAY=100

# Energy Milestones (Wh)
MILESTONE_100WH=true
MILESTONE_500WH=true
MILESTONE_1KWH=true
MILESTONE_5KWH=true

# Battery Thresholds (%)
BATTERY_ALERT_LOW_1=20
BATTERY_ALERT_LOW_2=10
BATTERY_ALERT_FULL=100

# Chat Feature Configuration
CHAT_RATE_LIMIT_TTL=60
CHAT_RATE_LIMIT_MAX=10
CHAT_SESSION_TIMEOUT_MINUTES=30

# Public API Configuration
PUBLIC_TELEMETRY_CACHE_TTL=5
PUBLIC_API_RATE_LIMIT_TTL=60
PUBLIC_API_RATE_LIMIT_MAX=120

# Email Configuration (Resend - Recommended)
# Sign up at https://resend.com and get your API key
# Verify your domain or sender email in Resend dashboard
# IMPORTANT: Use ONLY the email address without angle brackets
#
# Example:
# ✅ CORRECT: EMAIL_FROM=noreply@yourdomain.com
# ❌ WRONG:   EMAIL_FROM= <noreply@yourdomain.com>
#
# The EMAIL_FROM address will be used in administrator access code emails.
# The login link will use FRONTEND_URL (set above).
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=EcoStep System

# Legacy Email Configuration (Nodemailer/SMTP - Deprecated)
# Only use if NOT using Resend above
# For Gmail:
# 1. Enable 2-factor authentication on your Gmail account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use the App Password as EMAIL_PASSWORD
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your_app_password_here


# ============================================================
# PIEZOELECTRIC SENSOR CONFIGURATION
# ============================================================
# Configuration for ESP32 piezoelectric footstep energy harvesting
# Hardware: 10-15 piezo discs → LTC3588-1 → 2200µF 50V capacitor

# Voltage threshold for trigger detection (in volts)
# Minimum voltage increase to detect as footstep (default: 0.030V = 30mV)
PIEZO_VOLTAGE_THRESHOLD=0.030

# Maximum credible voltage change (in volts)
# Readings exceeding this are considered noise (default: 1.5V)
PIEZO_MAX_VOLTAGE_CHANGE=1.5

# Maximum capacitor voltage (in volts)
# Hardware limit for safety (default: 50V)
PIEZO_MAX_VOLTAGE=50

# Capacitance value (in Farads)
# 2200µF = 0.0022F (default: 0.0022)
PIEZO_CAPACITANCE=0.0022

# Capacitor full alert threshold (percentage as decimal)
# Emit alert when capacitor reaches this level (default: 0.9 = 90%)
PIEZO_CAPACITOR_FULL_THRESHOLD=0.9

# Step count milestones (set to 'false' to disable)
# Emit notifications when these step counts are reached
PIEZO_STEP_MILESTONE_100=true
PIEZO_STEP_MILESTONE_500=true
PIEZO_STEP_MILESTONE_1000=true
PIEZO_STEP_MILESTONE_5000=true
PIEZO_STEP_MILESTONE_10000=true
