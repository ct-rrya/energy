# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Database
MONGODB_URI=

# JWT Authentication
JWT_SECRET=
JWT_EXPIRATION=7d

# Initial Admin Account (for seed script)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Messenger Bot (Facebook)
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_VERIFY_TOKEN=
MESSENGER_APP_SECRET=

# ESP32 Authentication
IOT_API_KEY=

# CORS
CORS_ORIGIN=http://localhost:3001

# Notifications
ENABLE_NOTIFICATIONS=true
NOTIFICATION_THRESHOLD_POWER=100
